    {
      "id": "vvGshmV4cs-w5eepLQtha",
      "type": "text",
      "x": 7871.791896589681,
      "y": -4909.8580546164285,
      "width": 1022.9921875,
      "height": 1975,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0O",
      "roundness": null,
      "seed": 665962755,
      "version": 1251,
      "versionNonce": 1053803629,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1788639081920,
      "link": null,
      "locked": false,
      "text": "                                  ┌───────────────────────────────┐\n                                  │        TELEMETRY SOURCES      │\n                                  │                               │\n                                  │ Apps / SDKs / Agents          │\n                                  │ Kubernetes / VMs / Hosts      │\n                                  │ Prometheus / Logs / Kafka     │\n                                  │ Databases / Cloud / Network   │\n                                  └───────────────┬───────────────┘\n                                                  │\n                                                  ▼\n              ┌─────────────────────────────────────────────────────────────────────────────┐\n              │                              RECEIVERS                                      │\n              │                                                                             │\n              │ OTLP │ Prometheus │ Jaeger │ Zipkin │ Kafka │ Filelog │ Hostmetrics         │\n              │ Kubelet │ Kubernetes │ Syslog │ Fluent │ AWS │ Azure │ DB │ etc.            │\n              └────────────────────────────────┬────────────────────────────────────────────┘\n                                               │\n                                               ▼\n                                  ┌──────────────────────────┐\n                                  │       PIPELINE           │\n                                  │                          │\n                                  │   traces                 │\n                                  │   metrics                │\n                                  │   logs                   │\n                                  └────────────┬─────────────┘\n                                               │\n                                               ▼\n              ┌─────────────────────────────────────────────────────────────────────────────┐\n              │                             PROCESSORS                                      │\n              │                                                                             │\n              │  │\n              └────────────────────────────────┬────────────────────────────────────────────┘\n                                               │\n                                               ▼\n                                      ┌─────────────────┐\n                                      │    CONNECTOR    │\n                                      │                 │\n                                      │ pipeline A      │\n                                      │       │         │\n                                      │       ▼         │\n                                      │ pipeline B      │\n                                      └───────┬─────────┘\n                                              │\n                                  ┌───────────┴─────────────┐\n                                  │                         │\n                                  ▼                         ▼\n                            PIPELINE B                  PIPELINE C\n                                  │                         │\n                                  ▼                         ▼\n                            PROCESSORS                 PROCESSORS\n                                  │                         │\n                                  └────────────┬────────────┘\n                                               │\n                                               ▼\n          ┌─────────────────────────────────────────────────────────────────────────────┐\n          │                              EXPORTERS                                      │\n          │                                                                             │\n          │          │\n          └────────────────────────────────┬────────────────────────────────────────────┘\n                                           │\n                                           ▼\n          ┌─────────────────────────────────────────────────────────────────────────────┐\n          │                         OBSERVABILITY BACKENDS                              │\n          │                                                                             │\n          │ Grafana │ Prometheus │ Mimir │ Loki │ Tempo │ Jaeger │ Splunk │ Datadog     │\n          │ OpenSearch │ Elastic │ Cloud providers │ SIEM │ Data Lake │ etc.            │\n          └─────────────────────────────────────────────────────────────────────────────┘\n\n\n                      ┌─────────────────────────────────────────────┐\n                      │                 EXTENSIONS                  │\n                      │                                             │\n                      │ Health Check │ pprof │ zPages │ Auth        │\n                      │ File Storage │ OAuth │ AWS Auth │ Observer  │\n                      │ Service Discovery │ etc.                    │\n                      └─────────────────────────────────────────────┘\n                                              │\n                                              ▼\n                                        COLLECTOR RUNTIME",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "HGjVzTFndJsr4Fe6_gyq5",
      "originalText": "                                  ┌───────────────────────────────┐\n                                  │        TELEMETRY SOURCES      │\n                                  │                               │\n                                  │ Apps / SDKs / Agents          │\n                                  │ Kubernetes / VMs / Hosts      │\n                                  │ Prometheus / Logs / Kafka     │\n                                  │ Databases / Cloud / Network   │\n                                  └───────────────┬───────────────┘\n                                                  │\n                                                  ▼\n              ┌─────────────────────────────────────────────────────────────────────────────┐\n              │                              RECEIVERS                                      │\n              │                                                                             │\n              │ OTLP │ Prometheus │ Jaeger │ Zipkin │ Kafka │ Filelog │ Hostmetrics         │\n              │ Kubelet │ Kubernetes │ Syslog │ Fluent │ AWS │ Azure │ DB │ etc.            │\n              └────────────────────────────────┬────────────────────────────────────────────┘\n                                               │\n                                               ▼\n                                  ┌──────────────────────────┐\n                                  │       PIPELINE           │\n                                  │                          │\n                                  │   traces                 │\n                                  │   metrics                │\n                                  │   logs                   │\n                                  └────────────┬─────────────┘\n                                               │\n                                               ▼\n              ┌─────────────────────────────────────────────────────────────────────────────┐\n              │                             PROCESSORS                                      │\n              │                                                                             │\n              │  │\n              └────────────────────────────────┬────────────────────────────────────────────┘\n                                               │\n                                               ▼\n                                      ┌─────────────────┐\n                                      │    CONNECTOR    │\n                                      │                 │\n                                      │ pipeline A      │\n                                      │       │         │\n                                      │       ▼         │\n                                      │ pipeline B      │\n                                      └───────┬─────────┘\n                                              │\n                                  ┌───────────┴─────────────┐\n                                  │                         │\n                                  ▼                         ▼\n                            PIPELINE B                  PIPELINE C\n                                  │                         │\n                                  ▼                         ▼\n                            PROCESSORS                 PROCESSORS\n                                  │                         │\n                                  └────────────┬────────────┘\n                                               │\n                                               ▼\n          ┌─────────────────────────────────────────────────────────────────────────────┐\n          │                              EXPORTERS                                      │\n          │                                                                             │\n          │          │\n          └────────────────────────────────┬────────────────────────────────────────────┘\n                                           │\n                                           ▼\n          ┌─────────────────────────────────────────────────────────────────────────────┐\n          │                         OBSERVABILITY BACKENDS                              │\n          │                                                                             │\n          │ Grafana │ Prometheus │ Mimir │ Loki │ Tempo │ Jaeger │ Splunk │ Datadog     │\n          │ OpenSearch │ Elastic │ Cloud providers │ SIEM │ Data Lake │ etc.            │\n          └─────────────────────────────────────────────────────────────────────────────┘\n\n\n                      ┌─────────────────────────────────────────────┐\n                      │                 EXTENSIONS                  │\n                      │                                             │\n                      │ Health Check │ pprof │ zPages │ Auth        │\n                      │ File Storage │ OAuth │ AWS Auth │ Observer  │\n                      │ Service Discovery │ etc.                    │\n                      └─────────────────────────────────────────────┘\n                                              │\n                                              ▼\n                                        COLLECTOR RUNTIME",
      "autoResize": true,
      "lineHeight": 1.25
    },
