    {
      "id": "Co1p88lGkcXRVZvZJaFTg",
      "type": "text",
      "x": -7497.109451450556,
      "y": -722.3175767600545,
      "width": 1223.4375,
      "height": 2505.6,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8s",
      "roundness": null,
      "seed": 1319304259,
      "version": 122,
      "versionNonce": 1143307405,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788638530991,
      "link": null,
      "locked": false,
      "text": " Se eu fosse montar seu mapa de conhecimento, faria assim:\n\n                         OPEN TELEMETRY\n                                │\n          ┌─────────────────────┼──────────────────────┐\n          │                     │                      │\n          ▼                     ▼                      ▼\n       TRACES                METRICS                  LOGS\n          │                     │                      │\n          └─────────────────────┼──────────────────────┘\n                                │\n                                ▼\n                         OTEL COLLECTOR\n                                │\n             ┌──────────────────┼─────────────────┐\n             │                  │                 │\n             ▼                  ▼                 ▼\n         RECEIVERS          PROCESSORS        EXPORTERS\n             │                  │                 │\n             │                  │                 │\n      ┌──────┼──────┐      ┌────┼─────┐      ┌───┼────┐\n      │      │      │      │    │     │      │   │    │\n     OTLP  Prom   Filelog  Transform Batch Sampling OTLP\n      │      │      │      │    │     │      │   │\n      │      │      │      │    │     │      │   └─ Loki\n      │      │      │      │    │     │      └───── Mimir\n      │      │      │      │    │     └────────── Tempo\n      │      │      │      │    │\n      │      │      │      │    └── Memory\n      │      │      │      └────── K8s\n      │      │      └───────────── Resource\n      │      └──────────────────── Attributes\n      │\n      ▼\n   PIPELINE\n      │\n      ▼\n CONNECTORS\n      │\n      ├── routing\n      ├── spanmetrics\n      ├── servicegraph\n      ├── count\n      ├── sum\n      ├── failover\n      └── ...\n      │\n      ▼\n OTHER PIPELINE\n      │\n      ▼\n EXPORTERS\n      │\n      ▼\n BACKENDS\n      │\n      ▼\n Services",
      "fontSize": 36,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "VCa1LRldLTsV05GM5PvBB",
      "originalText": " Se eu fosse montar seu mapa de conhecimento, faria assim:\n\n                         OPEN TELEMETRY\n                                │\n          ┌─────────────────────┼──────────────────────┐\n          │                     │                      │\n          ▼                     ▼                      ▼\n       TRACES                METRICS                  LOGS\n          │                     │                      │\n          └─────────────────────┼──────────────────────┘\n                                │\n                                ▼\n                         OTEL COLLECTOR\n                                │\n             ┌──────────────────┼─────────────────┐\n             │                  │                 │\n             ▼                  ▼                 ▼\n         RECEIVERS          PROCESSORS        EXPORTERS\n             │                  │                 │\n             │                  │                 │\n      ┌──────┼──────┐      ┌────┼─────┐      ┌───┼────┐\n      │      │      │      │    │     │      │   │    │\n     OTLP  Prom   Filelog  Transform Batch Sampling OTLP\n      │      │      │      │    │     │      │   │\n      │      │      │      │    │     │      │   └─ Loki\n      │      │      │      │    │     │      └───── Mimir\n      │      │      │      │    │     └────────── Tempo\n      │      │      │      │    │\n      │      │      │      │    └── Memory\n      │      │      │      └────── K8s\n      │      │      └───────────── Resource\n      │      └──────────────────── Attributes\n      │\n      ▼\n   PIPELINE\n      │\n      ▼\n CONNECTORS\n      │\n      ├── routing\n      ├── spanmetrics\n      ├── servicegraph\n      ├── count\n      ├── sum\n      ├── failover\n      └── ...\n      │\n      ▼\n OTHER PIPELINE\n      │\n      ▼\n EXPORTERS\n      │\n      ▼\n BACKENDS\n      │\n      ▼\n Services",
      "autoResize": true,
      "lineHeight": 1.2
    },
