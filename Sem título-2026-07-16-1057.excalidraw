    {
      "id": "k31vMTJQ5_5vMAnWhi3m7",
      "type": "text",
      "x": 4955.930011296589,
      "y": 465.9871320952634,
      "width": 433.59375,
      "height": 864,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
