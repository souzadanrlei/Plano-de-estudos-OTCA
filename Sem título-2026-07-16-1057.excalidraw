    },
    {
      "id": "2hiwcog8agGcjTeu_2zQU",
      "type": "text",
      "x": 2125.5338985013436,
      "y": 10016.38592482948,
      "width": 485.15625,
      "height": 1080,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b85",
      "roundness": null,
      "seed": 720086925,
      "version": 390,
      "versionNonce": 1225317635,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788637677478,
      "link": null,
      "locked": false,
      "text": "Extensions também podem\nfornecer mecanismos de\nautenticação.\n\nPor exemplo:\n\nBasic Auth\nBearer Token\nOAuth2\nAWS authentication\nAzure authentication\n\nO modelo é:\n\nReceiver\n   │\n   ▼\nAuthentication\n   │\n   ▼\nPipeline\n\nou aplicado no lado do\nexporter, dependendo do\ncomponente.",
      "fontSize": 36,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ghD9GgN9OnhQeB309rTAJ",
      "originalText": "Extensions também podem fornecer mecanismos de autenticação.\n\nPor exemplo:\n\nBasic Auth\nBearer Token\nOAuth2\nAWS authentication\nAzure authentication\n\nO modelo é:\n\nReceiver\n   │\n   ▼\nAuthentication\n   │\n   ▼\nPipeline\n\nou aplicado no lado do exporter, dependendo do componente.",
      "autoResize": true,
      "lineHeight": 1.2
