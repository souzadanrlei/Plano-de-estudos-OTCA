    {
      "id": "D2ucvX0Cd3gV5cTg53sD-",
      "type": "text",
      "x": 3045.917362487066,
      "y": 4031.558560666692,
      "width": 550.78125,
      "height": 1272,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6Q",
      "roundness": null,
      "seed": 496852621,
      "version": 486,
      "versionNonce": 483097165,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788635793152,
      "link": null,
      "locked": false,
      "text": "Aqui temos:\n\nattributes\nresource\nk8sattributes\nresourcedetection\nAttributes\n\nManipula atributos:\n\nattributes:\n  environment = production\n  team = payments\n  region = sp\n\nPode:\n\nINSERT\nUPDATE\nUPSERT\nDELETE\nHASH\nEXTRACT\n8. Resource Processor\n\nEsse é fundamental para entender OpenTelemetry.\n\nVocê pode manipular:\n\nresource.attributes\n\nExemplo:\n\nservice.name\nservice.namespace\nservice.version\ndeployment.environment\ncloud.provider\ncloud.region\nk8s.cluster.name\n\nMentalmente:\n\n                 TELEMETRY\n                     │\n                     ▼\n              ┌─────────────┐\n              │   RESOURCE  │\n              └─────────────┘\n                     │\n          ┌──────────┼──────────┐\n          ▼          ▼          ▼\n       service      cloud       k8s",
      "fontSize": 20,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "RLGN5KGlhKBGanV8eb3yq",
      "originalText": "Aqui temos:\n\nattributes\nresource\nk8sattributes\nresourcedetection\nAttributes\n\nManipula atributos:\n\nattributes:\n  environment = production\n  team = payments\n  region = sp\n\nPode:\n\nINSERT\nUPDATE\nUPSERT\nDELETE\nHASH\nEXTRACT\n8. Resource Processor\n\nEsse é fundamental para entender OpenTelemetry.\n\nVocê pode manipular:\n\nresource.attributes\n\nExemplo:\n\nservice.name\nservice.namespace\nservice.version\ndeployment.environment\ncloud.provider\ncloud.region\nk8s.cluster.name\n\nMentalmente:\n\n                 TELEMETRY\n                     │\n                     ▼\n              ┌─────────────┐\n              │   RESOURCE  │\n              └─────────────┘\n                     │\n          ┌──────────┼──────────┐\n          ▼          ▼          ▼\n       service      cloud       k8s",
      "autoResize": true,
      "lineHeight": 1.2
    },
