    {
      "id": "vwbd8tyKEx9BDm2ZwZYt3",
      "type": "text",
      "x": 12924.184199343093,
      "y": -1757.8447175682059,
      "width": 1729.6875,
      "height": 1771.1999999999998,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
