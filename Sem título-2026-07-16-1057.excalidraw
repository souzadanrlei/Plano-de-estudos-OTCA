    {
      "id": "BdbowzsXqA7AEQrOrfxLr",
      "type": "text",
      "x": 12983.090306266095,
      "y": 602.5206351806896,
      "width": 836.71875,
      "height": 873.6,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 4,
